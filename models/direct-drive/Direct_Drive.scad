// Canon RF 35 mm direct drive cap, V16. Dimensions in mm.
// Self-contained model with the original lens interface mesh embedded.
// Choose assembly, sweep, base, or cap. F6 renders the chosen part.
part = "assembly";
open_angle = 135;
display_angle = 0;

// Measured SER0049 and stock horn dimensions, all in mm.
servo_body_length = 22.78;
servo_body_width = 12.06;
servo_body_depth = 23.38;  // Rear face to tab seating plane.
servo_tab_thickness = 2.44;
servo_tab_hole_diameter = 2.00;
mount_hole_spacing = 27.40;
mount_hole_diameter = 2.30; // Clearance for nominal 2 mm mounting screws.
shaft_from_body_end = 5.79;
mount_hole_z_offset = 0;
shaft_tip_from_rear = 31.26;
housing_shoulder_from_tabs = 4.59;
housing_shoulder_diameter = 11.58;
// The rectangular face is forward of the tabs and behind the shoulder.
// Use the full measured tab-to-shoulder distance as the clearance limit.
rectangular_nose_keepout_depth = housing_shoulder_from_tabs;
rectangular_nose_clearance = 0.30;
shaft_diameter = 4.74;

// Installed stock horn establishes the axial position of the rotating hub.
installed_horn_top_from_rear = 33.14;
stock_horn_total_thickness = 4.15;
shaft_recess_depth = shaft_tip_from_rear
    - (installed_horn_top_from_rear-stock_horn_total_thickness);
shaft_recess_diameter = shaft_diameter+0.14;
screw_thread_diameter = 2.00;
screw_under_head_length = 7.70;
screw_head_diameter = 5.00;
screw_clearance_diameter = screw_thread_diameter+0.25;
screw_head_recess_diameter = screw_head_diameter+0.30;
screw_head_recess_depth = 1.10;
screw_seat_thickness = stock_horn_total_thickness
    - shaft_recess_depth-screw_head_recess_depth;

$fn = 120;
ring_radius = 27.7;
rim_height = 6.75;
rim_inner_radius = 25.7;
lid_radius = 28.2;
lid_thickness = 1.6;
pivot = [38, -14, 8];
mount_face_y = pivot.y - (installed_horn_top_from_rear
    - stock_horn_total_thickness-servo_body_depth);
mount_center_x = pivot.x + servo_body_length/2 - shaft_from_body_end;
mount_hole_z = pivot.z + mount_hole_z_offset;
mount_plate_thickness = 1.9;

hub_radius = 4.8;
brace_thickness = 2.0;
cradle_floor_top = 1.65;
upper_bridge_radius = 1.30;
upper_bridge_air_gap = 0.51;
upper_bridge_z = pivot.z + housing_shoulder_diameter/2
    + 0.35 + upper_bridge_air_gap + upper_bridge_radius;

// Original lens-facing geometry is at z <= 0 after this rigid transform.
module original_interface() {
    intersection() {
        rotate([90, 0, 0])
            translate([-39.28856, -29.816093, -27.976998])
                original_base_mesh();
        // One full-depth trim removes the hinge and latch, including the
        // slivers at their roots. The lens-facing thread gap is preserved.
        translate([0,0,-3]) cylinder(r=27.72,h=6.5,$fn=360);
    }
}

// Rejoin the smooth barrel wall across the old latch notch. This sector
// begins above z=0, where the original lens threads end.
module notch_wall_fill() {
    start_z = 0.01;
    end_z = 3.0;
    inner_r = 24.2;
    outer_r = 27.7;
    half_angle = 16;
    rotate([0,0,180-half_angle])
        rotate_extrude(angle=2*half_angle,$fn=360)
            translate([inner_r,start_z])
                square([outer_r-inner_r,end_z-start_z]);
}

module axial_cylinder(radius, length) {
    rotate([-90,0,0]) cylinder(r=radius, h=length);
}

module rim() {
    difference() {
        translate([0,0,2.4]) cylinder(r=ring_radius, h=rim_height-2.4);
        translate([0,0,2.3]) cylinder(r=rim_inner_radius, h=rim_height-2.2);
    }
}

// The outer envelope eases continuously into the ring. Match the radius
// of its actual polygon at the join so the ramp ends at zero radial slope.
module ring_to_cradle() {
    start_angle = -87;
    end_angle = 69;
    segments = end_angle-start_angle;
    levels = 21;
    start_z = 0.04;
    function index(a,z,wall) = 2*(a*levels+z)+wall;
    function quad(a,b,c,d) = [[a,c,b],[a,d,c]];
    function smooth(t) = t*t*t*(10+t*(-15+6*t));
    function rim_radius_at(a) =
        ring_radius*cos(1.5)/cos(a-3*floor(a/3)-1.5);
    points = [for (a = [0:segments], z = [0:levels-1], wall = [0:1])
        let(angle = start_angle+a,
            t = min(1,(angle-start_angle)/61,(end_angle-angle)/68),
            h = z/(levels-1),
            height = start_z+(rim_height-start_z)*h,
            // The extension grows out of the same radial surface as the ring.
            // The narrow lobe reaches the near servo foot at its lower end.
            lobe_t = max(0,min(1,(angle+63)/29,(-13-angle)/21)),
            lobe = 7.55*smooth(lobe_t)*(1-smooth(min(1,height/5))),
            excess = 1.94*smooth(t)*(1-smooth(h))+lobe,
            radius = wall == 0 ? 26.65 : rim_radius_at(angle)+excess)
        [radius*cos(angle),radius*sin(angle),start_z+(rim_height-start_z)*h]];
    faces = [
        for (a = [0:segments-1], z = [0:levels-2]) each concat(
            quad(index(a,z,1),index(a+1,z,1),index(a+1,z+1,1),index(a,z+1,1)),
            quad(index(a,z,0),index(a,z+1,0),index(a+1,z+1,0),index(a+1,z,0))),
        for (a = [0:segments-1]) each concat(
            quad(index(a,0,0),index(a+1,0,0),index(a+1,0,1),index(a,0,1)),
            quad(index(a,levels-1,0),index(a,levels-1,1),
                 index(a+1,levels-1,1),index(a+1,levels-1,0))),
        for (z = [0:levels-2]) each concat(
            quad(index(0,z,0),index(0,z,1),index(0,z+1,1),index(0,z+1,0)),
            quad(index(segments,z,0),index(segments,z+1,0),
                 index(segments,z+1,1),index(segments,z,1)))
    ];
    polyhedron(points,faces,convexity=6);
}

module rounded_mount_ear(x) {
    hull() {
        for (dx = [-1.55,1.55])
            translate([x+dx,mount_face_y,1.37])
                axial_cylinder(1.05,mount_plate_thickness);
        translate([x,mount_face_y,mount_hole_z])
            axial_cylinder(2.65,mount_plate_thickness);
    }
}

// Close the mounting frame above the servo housing, in the ear plane.
module upper_bridge(hole_xs) {
    hull() {
        for (x = hole_xs)
            translate([x,mount_face_y,upper_bridge_z])
                axial_cylinder(upper_bridge_radius,mount_plate_thickness);
    }
    for (x = hole_xs)
        hull() {
            translate([x,mount_face_y,mount_hole_z])
                axial_cylinder(2.65,mount_plate_thickness);
            translate([x,mount_face_y,upper_bridge_z])
                axial_cylinder(upper_bridge_radius,mount_plate_thickness);
        }
}

module cradle_foot(x, y) {
    translate([x,y,0.25]) cylinder(r=3.15,h=cradle_floor_top-0.25,$fn=72);
}

module cradle_spine(x) {
    hull() {
        translate([x,mount_face_y,1.84])
            axial_cylinder(1.0,mount_plate_thickness);
        translate([x-1,mount_face_y,0.9])
            cube([2,mount_plate_thickness,0.3]);
    }
}

// A shallow diaphragm ties the far servo ear back to the ring.
module triangular_brace(near_x, far_x) {
    floor = 0.29;
    lip = 0.20;
    top = 0.25+brace_thickness;
    corner_r = 0.75;
    // Keep the entire brace on the shaft side of the servo seating plane.
    rail_y = mount_face_y + corner_r + 0.12;
    corners = [[26.6,0.2], [near_x-2.2,rail_y], [far_x,rail_y]];
    hull() {
        for (corner = corners) {
            translate([corner.x,corner.y,floor])
                cylinder(r=corner_r,h=top-floor-lip,$fn=48);
            translate([corner.x,corner.y,top-lip])
                cylinder(r1=corner_r,r2=0.50,h=lip,$fn=48);
        }
    }
}

// Conservative rectangular nose envelope, also shown in assembly view.
module servo_rectangular_nose(clearance=0) {
    translate([pivot.x-shaft_from_body_end-clearance,
               mount_face_y-0.05,
               pivot.z-servo_body_width/2-clearance])
        cube([servo_body_length+2*clearance,
              rectangular_nose_keepout_depth+0.05+clearance,
              servo_body_width+2*clearance]);
}

// Clearance envelope for the raised housing and its visible side lobe.
// The lobe is conservatively covered by extending the shoulder outline
// toward the long end of the body. Its exact outline was not measured.
module servo_front_housing(clearance=0) {
    radius = housing_shoulder_diameter/2+clearance;
    hull() {
        for (dx = [0,6])
            translate([pivot.x+dx,mount_face_y-0.01,pivot.z])
                axial_cylinder(radius,housing_shoulder_from_tabs+0.01+clearance);
    }
}

module mount() {
    hole_xs = [mount_center_x-mount_hole_spacing/2,
               mount_center_x+mount_hole_spacing/2];
    foot_y = mount_face_y + mount_plate_thickness - 3.15 - 0.2;
    difference() {
        union() {
            ring_to_cradle();
            triangular_brace(hole_xs[0],hole_xs[1]);
            upper_bridge(hole_xs);

            // Keep the wide footing beneath the case. The retained spine
            // rises only on the shaft side of the servo mounting plane.
            hull() {
                for (x = hole_xs) {
                    cradle_foot(x,foot_y);
                    translate([x,mount_face_y+mount_plate_thickness/2,0.25])
                        cylinder(r=0.85,h=cradle_floor_top-0.25,$fn=48);
                }
            }
            hull() {
                for (x = hole_xs) cradle_spine(x);
            }

            // Run both screw bosses into the rail over a gradual taper.
            // This gives the ears a broad root through the print layers.
            for (i = [0,1]) {
                x = hole_xs[i];
                slope_end = x + (hole_xs[1-i]-x)*0.40;
                hull() {
                    rounded_mount_ear(x);
                    cradle_spine(slope_end);
                }
            }
        }
        servo_rectangular_nose(rectangular_nose_clearance);
        servo_front_housing(0.35);
        // Keep the tab seating plane clear on its servo side. Only the
        // low footing can extend behind it, beneath the case and tabs.
        translate([-100,mount_face_y-100,cradle_floor_top])
            cube([200,100,100]);
        // The flared footing can touch the bore when the tab spacing changes.
        translate([0,0,0.15]) cylinder(r=rim_inner_radius,h=11);
        for (x = hole_xs)
            translate([x,mount_face_y-0.25,mount_hole_z])
                axial_cylinder(mount_hole_diameter/2,mount_plate_thickness+0.5);
    }
}

module base() {
    union() {
        original_interface();
        notch_wall_fill();
        rim();
        mount();
    }
}

// Round cross-sections spread bending loads from the hub into the lid.
// The larger shoulder carries the load into the flared lid root.
module arm_shoulder() {
    translate(pivot+[-3.5,0.85,1.50])
        axial_cylinder(2.20,5.00);
}

// Elliptical sections progressively widen and settle into the lid plane.
// The inner section is completely inside the lid, so the flare ends flush.
module lid_root_section(t) {
    eased = t*t*(3-2*t);
    x = 18 + 10*t;
    y = -7.0 - 2.6*eased;
    half_width = 4.5 - 1.8*eased;
    low = pivot.z + 0.02 - 0.47*eased;
    high = pivot.z + lid_thickness - 0.02 + 1.62*eased;
    translate([x-0.025,y,(low+high)/2])
        rotate([0,90,0])
            scale([(high-low)/2,half_width,1])
                cylinder(r=1,h=0.05,$fn=48);
}

module reinforced_arm(total_depth) {
    hull() {
        translate(pivot+[0,0.12,0])
            axial_cylinder(hub_radius,total_depth-0.24);
        arm_shoulder();
    }
    hull() {
        arm_shoulder();
        lid_root_section(1);
    }
    for (i = [0:15])
        hull() {
            lid_root_section(i/16);
            lid_root_section((i+1)/16);
        }
}

module lid_closed() {
    total_depth = shaft_recess_depth + screw_seat_thickness + screw_head_recess_depth;
    difference() {
        union() {
            translate([0,0,pivot.z]) cylinder(r=lid_radius,h=lid_thickness);
            reinforced_arm(total_depth);
            translate(pivot) axial_cylinder(hub_radius,total_depth);
        }
        translate(pivot+[0,-0.10,0])
            axial_cylinder(shaft_recess_diameter/2,shaft_recess_depth+0.10);
        translate(pivot+[0,-0.10,0])
            axial_cylinder(screw_clearance_diameter/2,total_depth+0.20);
        translate(pivot+[0,shaft_recess_depth+screw_seat_thickness,0])
            axial_cylinder(screw_head_recess_diameter/2,screw_head_recess_depth+0.10);
    }
}

module lid(angle) {
    translate(pivot) rotate([0,angle,0]) translate(-pivot) lid_closed();
}

module servo_envelope() {
    translate([mount_center_x-servo_body_length/2,
               mount_face_y-servo_body_depth, pivot.z-servo_body_width/2])
        cube([servo_body_length,servo_body_depth,servo_body_width]);
    servo_rectangular_nose();
    servo_front_housing();
    translate([pivot.x,mount_face_y+housing_shoulder_from_tabs,pivot.z])
        axial_cylinder(shaft_diameter/2,
            shaft_tip_from_rear-servo_body_depth-housing_shoulder_from_tabs);
}

if (part == "base") base();
if (part == "cap") lid_closed();
if (part == "assembly" || part == "sweep") {
    color("#395d74") base();
    color("#555a63") servo_envelope();
    color("#c67330") lid(display_angle);
    if (part == "sweep")
        for (angle = [45,90,open_angle])
            color("#c67330",0.28) lid(angle);
}

